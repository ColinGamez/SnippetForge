{
  "name": "snippet-forge",
  "displayName": "Colin's Snippet Forge",
  "description": "Turn selected code into reusable VS Code workspace snippets with smart placeholder suggestions.",
  "version": "0.1.0",
  "publisher": "ColinGamez",
  "license": "MIT",
  "main": "./extension.js",
  "activationEvents": [
    "onCommand:snippet-forge.createFromSelection",
    "onCommand:snippet-forge.openWorkspaceSnippets"
  ],
  "extensionKind": [
    "ui"
  ],
  "icon": "assets/icon.png",
  "galleryBanner": {
    "color": "#180602",
    "theme": "dark"
  },
  "pricing": "Free",
  "repository": {
    "type": "git",
    "url": "https://github.com/ColinGamez/SnippetForge.git"
  },
  "homepage": "https://github.com/ColinGamez/SnippetForge#readme",
  "bugs": {
    "url": "https://github.com/ColinGamez/SnippetForge/issues"
  },
  "scripts": {
    "build": "node scripts/check-package.mjs"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Snippets",
    "Other"
  ],
  "keywords": [
    "snippets",
    "snippet generator",
    "workspace snippets",
    "code snippets",
    "placeholders",
    "selection",
    "developer tools",
    "vs code"
  ],
  "contributes": {
    "commands": [
      {
        "command": "snippet-forge.createFromSelection",
        "title": "Forge Snippet From Selection",
        "category": "Colin's Snippet Forge"
      },
      {
        "command": "snippet-forge.openWorkspaceSnippets",
        "title": "Open Snippet Forge Workspace Snippets",
        "category": "Colin's Snippet Forge"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "snippet-forge.createFromSelection",
          "when": "editorHasSelection",
          "group": "navigation"
        }
      ]
    }
  }
}
